-- Função auxiliar para criar botões com estilo uniforme
local function CriarBotaoAlternador(texto, callback)
    local Botao = Instance.new("TextButton")
    Botao.Size = UDim2.new(1, 0, 0, 38)
    Botao.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    Botao.Text = texto
    Botao.TextColor3 = Color3.fromRGB(255, 255, 255)
    Botao.TextSize = 14
    Botao.Font = Enum.Font.SourceSans
    Botao.BorderSizePixel = 0
    Botao.Parent = Container
    
    local BCorner = Instance.new("UICorner")
    BCorner.CornerRadius = UDim.new(0, 5)
    BCorner.Parent = Botao
    
    local ativo = false
    Botao.MouseButton1Click:Connect(function()
        ativo = not ativo
        if ativo then
            Botao.BackgroundColor3 = Color3.fromRGB(255, 100, 0) -- Laranja Ativo Octos
        else
            Botao.BackgroundColor3 = Color3.fromRGB(30, 30, 45) -- Cor padrão
        end
        callback(ativo)
    end)
end

-- ====================================================================
--                      FUNÇÕES DO HUB (OCTOS FEATURES)
-- ====================================================================

-- 1. Botão de Velocidade Segura
CriarBotaoAlternador("Alternar Velocidade Rápida (32)", function(estado)
    if estado then
        _G.WalkSpeedValue = 32
    else
        _G.WalkSpeedValue = 16
    end
end)

-- 2. Botão de NoClip (Atravessar Paredes)
CriarBotaoAlternador("Atravessar Paredes (NoClip)", function(estado)
    _G.NoClipEnabled = estado
end)

-- Função auxiliar para aplicar o efeito brilhante do ESP
local function AplicarEfeitoESP(obj)
    -- Verifica se é um monstro (Dandy's World costuma usar "Twisted" ou o modelo contendo Humanoid)
    if string.find(string.lower(obj.Name), "twisted") or (obj:FindFirstChild("Humanoid") and obj.Name ~= LocalPlayer.Name) then
        if not obj:FindFirstChild("OctosHighlight") then
            local Highlight = Instance.new("Highlight")
            Highlight.Name = "OctosHighlight"
            Highlight.FillColor = Color3.fromRGB(255, 0, 100) -- Rosa/Vermelho Neon
            Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            Highlight.Parent = obj
        end
    end
end

-- 3. Botão de ESP (Ver Monstros/Twisteds na parede)
CriarBotaoAlternador("Destacar Monstros (ESP)", function(estado)
    _G.EspMonstrosEnabled = estado
    
    if estado then
        -- Aplica nos monstros que já estão no mapa agora
        for _, obj in pairs(Workspace:GetDescendants()) do
            AplicarEfeitoESP(obj)
        end
    else
        -- Remove o brilho se desativado
        for _, obj in pairs(Workspace:GetDescendants()) do
            local hl = obj:FindFirstChild("OctosHighlight")
            if hl then hl:Destroy() end
        end
    end
end)

-- Monitora o mapa em tempo real caso novos monstros apareçam
Workspace.DescendantAdded:Connect(function(novoObj)
    if _G.EspMonstrosEnabled then
        task.wait(0.5) -- Pequeno delay para o jogo carregar o monstro por completo
        AplicarEfeitoESP(novoObj)
    end
end)

