-- 1. Carregamento Seguro e Verificação
if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- Variáveis de controle das trapaças
local _G = getgenv and getgenv() or {}
_G.WalkSpeedValue = 16
_G.NoClipEnabled = false
_G.EspMonstrosEnabled = false

-- Atualizar o personagem quando o jogador morre/renasce
LocalPlayer.CharacterAdded:Connect(function(novoChar)
    Character = novoChar
    Humanoid = novoChar:WaitForChild("Humanoid")
end)

-- 2. Loop de funcionamento do NoClip (Seguro)
RunService.Stepped:Connect(function()
    if _G.NoClipEnabled and Character then
        for _, parte in pairs(Character:GetChildren()) do
            if parte:IsA("BasePart") then
                parte.CanCollide = false
            end
        end
    end
end)

-- Loop de controle de velocidade constante (Bypass simples)
RunService.RenderStepped:Connect(function()
    if Humanoid and Humanoid.WalkSpeed ~= _G.WalkSpeedValue then
        Humanoid.WalkSpeed = _G.WalkSpeedValue
    end
end)

